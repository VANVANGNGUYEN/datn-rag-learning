# Cau hinh chia doan va truy xuat
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=3
MIN_SIMILARITY=0.08

# local: vector dac trung tu vung, chay khong can API
# api: goi dich vu cua mo hinh embedding co san
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=4096
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Neu bo trong khoa API, chuong trinh dung che do trich xuat cau tu tai lieu.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Ket noi MySQL (dung cho backend tu Tuan 6)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=datn_learning
DB_USER=datn_app
DB_PASSWORD=

